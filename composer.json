{
    "name": "dukstra/nova-items-field",
    "description": "Laravel Nova 5 field for editable string arrays, forked from dillingham/nova-items-field",
    "keywords": [
        "laravel",
        "nova",
        "items",
        "array"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "laravel/framework": "^13.0",
        "laravel/nova": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Dukstra\\NovaItemsField\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dukstra\\NovaItemsField\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
